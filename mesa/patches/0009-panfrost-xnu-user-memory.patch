diff --git a/src/gallium/drivers/panfrost/pan_resource.c b/src/gallium/drivers/panfrost/pan_resource.c
index 30b59e2..c56e62d 100644
--- a/src/gallium/drivers/panfrost/pan_resource.c
+++ b/src/gallium/drivers/panfrost/pan_resource.c
@@ -1201,6 +1201,58 @@ panfrost_resource_create_with_modifier(struct pipe_screen *screen,
    return (struct pipe_resource *)so;
 }
 
+#ifdef __APPLE__
+/* libdrm-xnu: a stand-in fd for the caller's page-aligned memory; importing it
+ * wires those pages and maps them into the GPU (VGPU_SEL_IMPORT_USERPTR). */
+int drmUserMemoryFDXNU(int fd, uint64_t addr, uint64_t size);
+void vmg_drm_surface_fd_close(int fd);
+
+/* Buffers over the application's memory (Metal's newBufferWithBytesNoCopy):
+ * the GPU uses the same pages, the CPU keeps the application's pointer. */
+static struct pipe_resource *
+panfrost_resource_from_user_memory(struct pipe_screen *pscreen,
+                                   const struct pipe_resource *templat,
+                                   void *user_memory)
+{
+   struct panfrost_device *dev = pan_device(pscreen);
+
+   if (templat->target != PIPE_BUFFER)
+      return NULL;
+
+   int fd = drmUserMemoryFDXNU(panfrost_device_fd(dev),
+                               (uint64_t)(uintptr_t)user_memory,
+                               templat->width0);
+   if (fd < 0)
+      return NULL;
+
+   struct panfrost_resource *rsc = CALLOC_STRUCT(panfrost_resource);
+   if (!rsc) {
+      vmg_drm_surface_fd_close(fd);
+      return NULL;
+   }
+
+   rsc->base = *templat;
+   rsc->base.screen = pscreen;
+   pipe_reference_init(&rsc->base.reference, 1);
+   util_range_init(&rsc->valid_buffer_range);
+   panfrost_resource_setup(pscreen, rsc, DRM_FORMAT_MOD_LINEAR,
+                           templat->format, 0);
+
+   int ret = panfrost_resource_import_bo(rsc, dev, fd);
+   vmg_drm_surface_fd_close(fd);
+   if (ret) {
+      panfrost_resource_destroy(pscreen, &rsc->base);
+      return NULL;
+   }
+
+   rsc->bo->flags |= PAN_BO_USER_MEMORY;
+   rsc->bo->ptr.cpu = user_memory;
+   rsc->plane.base = rsc->bo->ptr.gpu;
+   util_range_add(&rsc->base, &rsc->valid_buffer_range, 0, templat->width0);
+   return &rsc->base;
+}
+#endif
+
 /* Default is to create a resource as don't care */
 
