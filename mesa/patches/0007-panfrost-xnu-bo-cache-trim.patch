+/* XNU (Open Mapple): kern.mapple_gpu_bocache, 1 when absent. Stale BOs are also dropped when one is fetched from the
+ * cache and at each batch submit, so a process that stops freeing BOs does not keep its cache for ever. */
+static bool
+pan_bo_cache_trim_enabled(void)
+{
+#ifdef __APPLE__
+   static int on = 1;
+   static time_t checked;
+   time_t now = time(NULL);
+   if (now != checked) {
+      int v = 1;
+      size_t len = sizeof(v);
+      on = sysctlbyname("kern.mapple_gpu_bocache", &v, &len, NULL, 0) == 0 ? v != 0 : 1;
+      checked = now;
+   }
+   return on;
+#else
+   return false;
+#endif
+}
