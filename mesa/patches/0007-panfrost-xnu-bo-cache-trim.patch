+/* XNU (Open Mapple): stale BOs out at a batch submit (kern.mapple_gpu_bocache). */
+void
+panfrost_bo_cache_trim(struct panfrost_device *dev)
+{
+   if (!pan_bo_cache_trim_enabled())
+      return;
+   pthread_mutex_lock(&dev->bo_cache.lock);
+   panfrost_bo_cache_evict_stale_bos(dev);
+   pthread_mutex_unlock(&dev->bo_cache.lock);
+}
+
+/* XNU (Open Mapple): what the cache holds, for the driver's statistics. */
+size_t
+panfrost_bo_cache_bytes(struct panfrost_device *dev)
+{
+   size_t bytes = 0;
+   pthread_mutex_lock(&dev->bo_cache.lock);
+   list_for_each_entry(struct panfrost_bo, entry, &dev->bo_cache.lru, lru_link)
+      bytes += panfrost_bo_size(entry);
+   pthread_mutex_unlock(&dev->bo_cache.lock);
+   return bytes;
+}
+
+/* XNU (Open Mapple): the same for the embedding driver, by screen. */
+void
+panfrost_screen_bo_cache_empty(struct pipe_screen *screen)
+{
+   panfrost_bo_cache_evict_all(pan_device(screen));
+}
+
+size_t
+panfrost_screen_bo_cache_bytes(struct pipe_screen *screen)
+{
+   return panfrost_bo_cache_bytes(pan_device(screen));
+}
